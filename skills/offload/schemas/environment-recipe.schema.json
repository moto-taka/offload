{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os_family": {
          "enum": [
            "linux",
            "unknown"
          ]
        },
        "distribution_hint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "os_family",
        "distribution_hint"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version_requirement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "version_requirement",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "package_manager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_requirement": {
          "type": "string",
          "minLength": 1
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "version_requirement",
        "lockfiles"
      ]
    },
    "install": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "label",
          "argv",
          "cwd",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "start": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "label",
          "argv",
          "cwd",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "label",
          "argv",
          "cwd",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "label",
          "argv",
          "cwd",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "required_secret_names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "build",
              "runtime",
              "both"
            ]
          }
        },
        "required": [
          "name",
          "purpose",
          "phase"
        ]
      },
      "minItems": 0
    },
    "public_network_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "hostname",
          "purpose"
        ]
      },
      "minItems": 0
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "profile",
    "source_commit",
    "platform",
    "runtimes",
    "package_manager",
    "install",
    "start",
    "health_checks",
    "tests",
    "required_secret_names",
    "public_network_requirements",
    "source_refs",
    "unresolved"
  ],
  "title": "Offload EnvironmentRecipe v2.0",
  "description": "非秘密の環境設定案。ここに承認・アカウント・秘密値・VPN設定を追加してはならない。argvは提案でありCloudでの実行許可ではない。"
}
